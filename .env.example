# Folder of song folders served at /songs by `pnpm dev` and uploaded by `pnpm songs:publish`
# (default: ./songs)
# SONGS_DIR=/Users/you/Music/Stems

# Song library base URL. Dev default is /songs. Production builds use /songs too (see
# .env.production): the Cloudflare Worker serves it from R2 on the same origin.
# Set a full URL only to point at a library hosted elsewhere; leave unset for zip-only mode.
# VITE_SONGS_BASE_URL=/songs
