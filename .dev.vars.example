# Copy to .dev.vars (gitignored) for local runs: `wrangler dev`, `pnpm members ...`, `pnpm db:migrate`.
# Production uses `wrangler secret put` for the secrets; see docs/infra.md.

# Local origin, so cookies and the auth origin point at your machine
APP_URL=http://127.0.0.1:8787

# The Neon DEV database (never production; production lives in .prod.vars, used with --target prod).
# Neon dashboard > Connect > pooled connection string (host contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Resend > API Keys (sending access is enough)
RESEND_API_KEY=

# The church `pnpm dev` works in: a church slug in the dev database (see `pnpm churches list`)
DEV_CHURCH=
