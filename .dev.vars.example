# Copy to .dev.vars (gitignored) for local runs: `wrangler dev`, `pnpm members ...`, `pnpm db:migrate`.
# Production uses `wrangler secret put` for the secrets; see docs/infra.md.

# Local origin, so cookies and the auth origin point at your machine
APP_URL=http://127.0.0.1:8787

# The Neon development branch (never production; production lives in .prod.vars, used with --target prod).
# Two logins, both pooled connection strings (host contains "-pooler"):
#   DATABASE_OWNER_URL  the owner role (neondb_owner): scripts and migrations, which create and alter tables
#   DATABASE_URL        the app's role (worship_hub_worker): what the Worker uses, locally and deployed; data only.
#                       Created with SQL, not in the console (console roles are near-admin); see docs/infra.md.
DATABASE_OWNER_URL=postgresql://neondb_owner:PASSWORD@HOST-pooler.REGION.aws.neon.tech/worship_hub?sslmode=require
DATABASE_URL=postgresql://worship_hub_worker:PASSWORD@HOST-pooler.REGION.aws.neon.tech/worship_hub?sslmode=require

# Or a Postgres on this machine (`pnpm db:local`, needs Docker): set BOTH urls to the same local database
# (both local or both Neon), for example:
#   postgres://USER:PASSWORD@localhost:5432/worship_hub   (the throwaway login is in docker-compose.local.yml)
# If port 5433 is taken for its WebSocket proxy: LOCAL_DB_PROXY_PORT=5444
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Resend > API Keys (sending access is enough)
RESEND_API_KEY=
