{
  "name": "worship-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "cf:dev": "pnpm build && wrangler dev --infer-origin-from-routes=false",
    "cf:deploy:redirect": "wrangler deploy --config redirect/wrangler.jsonc",
    "cf:deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "songs:publish": "node scripts/publish-songs.ts",
    "songs:pack": "node scripts/pack-song.ts",
    "db:migrate": "node scripts/db-migrate.ts",
    "members": "node scripts/members.ts",
    "churches": "node scripts/churches.ts",
    "songs:analyse": "node scripts/analyse.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "better-auth": "1.7.19",
    "jszip": "^3.10.2",
    "kysely": "0.29.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "auth": "1.7.19",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  }
}
