{
  "name": "worship-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --infer-origin-from-routes=false --ip 127.0.0.1 --port 8787 --persist-to \"$(git rev-parse --path-format=absolute --git-common-dir)/../.wrangler/state\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "cf:deploy:redirect": "wrangler deploy --config src/redirect/wrangler.jsonc",
    "cf:deploy": "pnpm build && wrangler deploy",
    "smoke": "node src/cli/smoke.ts",
    "cf-typegen": "wrangler types src/api/worker-configuration.d.ts",
    "songs:publish": "node src/cli/publish-songs.ts",
    "songs:pack": "node src/cli/pack-song.ts",
    "db:local": "docker compose --env-file .dev.vars -f docker-compose.local.yml up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/cli/db-migrate.ts",
    "db:app-role": "node src/cli/db-app-role.ts",
    "db:move": "node src/cli/move-db.ts",
    "members": "node src/cli/members.ts",
    "churches": "node src/cli/churches.ts",
    "songs:analyse": "node src/cli/analyse.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@neondatabase/serverless": "1.2.0",
    "better-auth": "1.7.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "jszip": "^3.10.2",
    "lucide-react": "1.72.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "signalsmith-stretch": "1.3.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "0.31.11",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  }
}
